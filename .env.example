# Database
DATABASE_URL=postgresql://ecowatch:ecowatch@localhost:5432/ecowatch
POSTGRES_USER=ecowatch
POSTGRES_PASSWORD=ecowatch
POSTGRES_DB=ecowatch

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# External APIs
OPENWEATHER_API_KEY=your_openweather_api_key
WAQI_API_KEY=your_waqi_api_key
GEE_SERVICE_ACCOUNT=path/to/gee-credentials.json

# AI
OPENAI_API_KEY=your_openai_api_key

# App
BACKEND_URL=http://localhost:8002
FRONTEND_URL=http://localhost:3002
ENVIRONMENT=development
CACHE_TTL_SECONDS=300

# Auth (set a strong random secret in production)
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
AUTH_DATABASE_URL=sqlite+aiosqlite:///./data/ecowatch_auth.db
REQUIRE_AUTH=false
